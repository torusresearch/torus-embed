{
  "name": "@toruslabs/torus-embed",
  "version": "7.0.0",
  "description": "Embed script for Torus",
  "unpkg": "dist/torus.umd.min.js",
  "jsdelivr": "dist/torus.umd.min.js",
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "types": "dist/lib.cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torusresearch/torus-embed.git"
  },
  "scripts": {
    "build": "vp pack",
    "lint": "vp lint",
    "check": "vp check",
    "fix": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "prepack": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release-packages": "changeset publish",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@babel/runtime": "7.x"
  },
  "dependencies": {
    "@web3auth/ws-embed": "^6.1.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.15",
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "^0.9.0",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/torus-scripts": "9.0.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright": "^1.65.1",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0"
  },
  "mocha": {
    "timeout": 0
  },
  "keywords": [
    "torus",
    "wallet",
    "ERC20",
    "Ethereum",
    "embed",
    "login",
    "OAuth",
    "crypto"
  ],
  "author": "Torus Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/torusresearch/torus-embed/issues"
  },
  "homepage": "https://github.com/torusresearch/torus-embed#readme",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "vp lint --fix",
      "vp fmt"
    ],
    "*.{json,md,yml,yaml}": [
      "vp fmt"
    ]
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
